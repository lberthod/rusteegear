/target
.DS_Store
# Sortie de wasm-bindgen (Sprint 114) : régénérée par la CI/le script de build web
# depuis target/wasm32-unknown-unknown, jamais versionnée (36 Mo+ en debug).
/packaging/web/pkg/
/packaging/release.keystore
packaging/ios-xcode/Motor3DeRust.xcodeproj/
packaging/ios-xcode/build/
# Golden tests de rendu (Sprint 80) : image obtenue écrite pour inspection en cas
# d'échec — jamais la référence elle-même (tests/golden/*.png, versionnée).
tests/golden/*.actual.png

# Config locale des sessions Claude Code (permissions, worktrees d'agents
# concurrents) : jamais partagée, propre à chaque poste/session.
/.claude/
# Serveurs MCP locaux (ex. Blender) : outillage propre à ce poste, pas au dépôt.
/.mcp.json
__pycache__/

# Assemblage local du site water.loicberthod.ch (index.html + favicon + pkg/) :
# régénéré à chaque déploiement par la recette de docs/RIVIERE_CASCADE.md,
# jamais versionné (comme /packaging/web/pkg/).
/dist/
# Sauvegardes automatiques de Blender (.blend1) : seul le .blend source compte.
*.blend1
